# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，永不入库。
# 读取方：src/factorlab/config.py（优先级：环境变量 > .env > configs/default.yaml）

# ---- RQData（米筐）----
RQDATA_USERNAME=
RQDATA_PASSWORD=
# 也可用 license/key 二选一
RQDATA_LICENSE=
RQDATA_KEY=
# 或直接给 URI
RQDATA_URI=

# ---- 本地数据根目录（大数据可放 WSL 外的盘）----
# 留空则用仓库内 ./data
FACTORLAB_DATA_ROOT=
# 中间缓存（大 panel / pickle）建议指向大盘，默认 ./artifacts/cache
FACTORLAB_CACHE_ROOT=

# ---- 数据库（可选，旧项目 hfc 用 MySQL）----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
